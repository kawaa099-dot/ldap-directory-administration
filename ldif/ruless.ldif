olcAccess: {11}to dn.children="ou=prof,dc=beauxbatons,dc=arlinux,dc=com"
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="ou=alum,dc=beauxbatons,dc=arlinux,dc=com" read

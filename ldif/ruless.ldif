dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
# {0} userPassword:
# - admin can manage it
# - each user can read/write only their own password
# - anonymous may authenticate
# - nobody else can read it
olcAccess: {0}to attrs=userPassword
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by self write
  by anonymous auth
  by * none
-
add: olcAccess
# {1} Gryffindor students' mail
# - admin full control
# - Minerva and Dumbledore can modify
# - all professors can read
# - all students can read
olcAccess: {1}to dn.children="ou=gryf,ou=alum,dc=hogwarts,dc=arlinux,dc=com" attrs=mail
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.exact="cn=minerva,ou=prof,dc=hogwarts,dc=arlinux,dc=com" write
  by dn.exact="cn=dumbledore,ou=prof,dc=hogwarts,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com" read
  by self read
  by * break
-
add: olcAccess
# {2} Other Hogwarts students' mail (e.g. Hufflepuff)
# - admin full control
# - Dumbledore can modify
# - all professors can read
# - all students can read
olcAccess: {2}to dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com" attrs=mail
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.exact="cn=dumbledore,ou=prof,dc=hogwarts,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com" read
  by self read
  by * break
-
add: olcAccess
# {3} Mail of non-Hogwarts students (Beauxbatons / Durmstrang)
# - admin full control
# - professors can read
# - all students can read
olcAccess: {3}to attrs=mail
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="dc=arlinux,dc=com" read
  by self read
  by * break
-
add: olcAccess
# {4} telephoneNumber of Hogwarts students
# - admin full control
# - professors can read
# - Hogwarts students can read
olcAccess: {4}to dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com" attrs=telephoneNumber
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.exact="cn=dumbledore,ou=prof,dc=hogwarts,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com" read
  by self read
  by * break

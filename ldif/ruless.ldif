add: olcAccess
# {12} Durmstrang professors
olcAccess: {12}to dn.children="ou=prof,dc=durmstrang,dc=arlinux,dc=com"
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by dn.subtree="ou=alum,dc=durmstrang,dc=arlinux,dc=com" read
  by self read
  by * break
-
add: olcAccess
# {13} Hogwarts students (all attrs except userPassword)
# - admin full control
# - Dumbledore can modify all attrs
# - professors can read
# - each user reads own entry
olcAccess: {13}to dn.subtree="ou=alum,dc=hogwarts,dc=arlinux,dc=com"
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.exact="cn=dumbledore,ou=prof,dc=hogwarts,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by self read
  by * break
-
add: olcAccess
# {14} Catch-all
# - admin writes everything
# - professors read everything
# - each user reads own entry
olcAccess: {14}to *
  by dn.exact="cn=admin,dc=arlinux,dc=com" write
  by dn.regex="^.*,ou=prof,.*,dc=arlinux,dc=com$" read
  by self read
  by * none

olcAccess: {15}to dn.subtree="dc=arlinux,dc=com"
  by users read
  by * break